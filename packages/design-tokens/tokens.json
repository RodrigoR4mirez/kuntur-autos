{
  "$description": "Tokens de diseño de Kuntur Autos. Formato neutral (estilo W3C Design Tokens). Se transforman a CSS, TypeScript (React Native) y, si hace falta, Swift/Kotlin.",
  "color": {
    "brand": {
      "ink":        { "$type": "color", "$value": "#0D1B2A", "$description": "Noche Andina. Texto principal y fondo oscuro." },
      "ink-2":      { "$type": "color", "$value": "#16283D", "$description": "Superficie elevada en modo oscuro." },
      "cielo":      { "$type": "color", "$value": "#1F4FD8", "$description": "Cielo Kuntur. Color primario: enlaces, selección, acciones secundarias." },
      "cielo-claro":{ "$type": "color", "$value": "#7FA2FF", "$description": "Cielo Kuntur claro. Primario sobre fondos oscuros." },
      "rocoto":     { "$type": "color", "$value": "#BF3417", "$description": "Rocoto. Acción principal (CTA) en modo claro." },
      "rocoto-claro":{ "$type": "color", "$value": "#FF7A5C", "$description": "Rocoto claro. Acción principal en modo oscuro." },
      "oro":        { "$type": "color", "$value": "#E0A82E", "$description": "Oro Inca. Verificado, destacado y premium." }
    },
    "neutral": {
      "fondo":      { "$type": "color", "$value": "#F4F6FA" },
      "superficie": { "$type": "color", "$value": "#FFFFFF" },
      "linea":      { "$type": "color", "$value": "#D7DEE9" },
      "texto-suave":{ "$type": "color", "$value": "#4A5A70" },
      "texto-suave-oscuro": { "$type": "color", "$value": "#9FB0C8" }
    },
    "semantic": {
      "exito":      { "$type": "color", "$value": "#17784A" },
      "alerta":     { "$type": "color", "$value": "#F2B33D" },
      "error":      { "$type": "color", "$value": "#B3261E" }
    }
  },
  "theme": {
    "light": {
      "bg":          { "$type": "color", "$value": "{color.neutral.fondo}" },
      "surface":     { "$type": "color", "$value": "{color.neutral.superficie}" },
      "text":        { "$type": "color", "$value": "{color.brand.ink}" },
      "text-muted":  { "$type": "color", "$value": "{color.neutral.texto-suave}" },
      "border":      { "$type": "color", "$value": "{color.neutral.linea}" },
      "primary":     { "$type": "color", "$value": "{color.brand.cielo}" },
      "on-primary":  { "$type": "color", "$value": "#FFFFFF" },
      "action":      { "$type": "color", "$value": "{color.brand.rocoto}" },
      "on-action":   { "$type": "color", "$value": "#FFFFFF" },
      "verified":    { "$type": "color", "$value": "{color.brand.oro}" },
      "on-verified": { "$type": "color", "$value": "{color.brand.ink}" }
    },
    "dark": {
      "bg":          { "$type": "color", "$value": "{color.brand.ink}" },
      "surface":     { "$type": "color", "$value": "{color.brand.ink-2}" },
      "text":        { "$type": "color", "$value": "#FFFFFF" },
      "text-muted":  { "$type": "color", "$value": "{color.neutral.texto-suave-oscuro}" },
      "border":      { "$type": "color", "$value": "#2A3D55" },
      "primary":     { "$type": "color", "$value": "{color.brand.cielo-claro}" },
      "on-primary":  { "$type": "color", "$value": "{color.brand.ink}" },
      "action":      { "$type": "color", "$value": "{color.brand.rocoto-claro}" },
      "on-action":   { "$type": "color", "$value": "{color.brand.ink}" },
      "verified":    { "$type": "color", "$value": "{color.brand.oro}" },
      "on-verified": { "$type": "color", "$value": "{color.brand.ink}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Figtree", "system-ui", "sans-serif"] },
      "plate":   { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "Placas, precios y datos tabulares." }
    },
    "size": {
      "xs":  { "$type": "dimension", "$value": "0.75rem" },
      "sm":  { "$type": "dimension", "$value": "0.875rem" },
      "md":  { "$type": "dimension", "$value": "1rem" },
      "lg":  { "$type": "dimension", "$value": "1.25rem" },
      "xl":  { "$type": "dimension", "$value": "1.625rem" },
      "2xl": { "$type": "dimension", "$value": "2.125rem" },
      "3xl": { "$type": "dimension", "$value": "2.875rem" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm":  { "$type": "dimension", "$value": "6px" },
    "md":  { "$type": "dimension", "$value": "12px" },
    "lg":  { "$type": "dimension", "$value": "20px" },
    "pill":{ "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "slow": { "$type": "duration", "$value": "320ms" }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "480px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1100px" }
  }
}
