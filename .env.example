# Copia este archivo a .env. Nunca subas .env al repositorio.
PORT=3000
# PostgreSQL. Ejemplo local sin datos reales:
DATABASE_URL=postgres://kuntur:kuntur@localhost:5432/kuntur

# --- Inicio de sesión (opcional en desarrollo; ver docs/09-autenticacion.md) ---
# Secreto de sesiones: al menos 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
AUTH_SECRET=
# URL pública de la API. En desarrollo se usa http://localhost:PORT si falta.
AUTH_BASE_URL=
# Orígenes de la web autorizados, separados por comas. Ejemplo: http://localhost:3001
AUTH_TRUSTED_ORIGINS=
# Google OAuth (ambos o ninguno). Redirección autorizada: <AUTH_BASE_URL>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Correo por SMTP (ambos o ninguno). Sin ellos, en desarrollo el enlace de verificación se imprime en el registro.
SMTP_URL=
MAIL_FROM=
